{
  "name": "expressive-gmail",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "description": "Gmail rebuilt in Material 3 Expressive.",
  "license": "GPL-3.0-only",
  "repository": "github:slukedev/expressive-gmail",
  "homepage": "https://github.com/slukedev/expressive-gmail",
  "bugs": "https://github.com/slukedev/expressive-gmail/issues",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "preview": "vite --config vite.preview.config.ts",
    "build": "wxt build --mv3",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:safari": "wxt build -b safari --mv3",
    "build:all": "npm run build:chrome && npm run build:firefox && npm run build:safari",
    "safari:xcode": "sh scripts/package-safari.sh",
    "safari:install": "sh scripts/install-safari.sh",
    "safari:ios": "sh scripts/package-safari-ios.sh",
    "release:mac": "sh scripts/release-mac.sh",
    "release:appstore": "sh scripts/release-appstore.sh",
    "zip": "sh scripts/zip-stores.sh",
    "store:images": "node scripts/store-images.mjs",
    "check:no-demo": "node scripts/check-no-demo.mjs",
    "fonts": "python3 scripts/build_fonts.py",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:report": "node -e \"console.log('Playwright HTML report: ' + require('path').resolve('playwright-report/index.html'))\"",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@material/material-color-utilities": "^0.4.0",
    "@tanstack/react-query": "^5.104.1",
    "dompurify": "^3.4.16",
    "material-shapes-ts": "^0.3.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/google-sans-flex": "^5.3.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "material-symbols": "^0.48.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
